# ==============================================================================
# FinSightIQ Platform — Local Development Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before starting the platform:
#   cp .env.example .env
#
# DO NOT commit '.env' or real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform & Workspace Configuration
# ------------------------------------------------------------------------------
# GitHub username or organisation owning the sibling repositories
FINSIGHTIQ_OWNER=shashinherath

# GitHub Personal Access Token with 'read:packages' permission.
# Required for restoring shared NuGet packages (building-blocks, contracts) in Docker builds.
NUGET_TOKEN=ghp_example_token_placeholder

# ASP.NET Core environment mode (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 15)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Logical database names for each microservice
DB_USERS=usersdb
DB_MARKET=marketdb
DB_PREDICTION=predictiondb
DB_PORTFOLIO=portfoliodb
DB_SENTIMENT=sentimentdb

# Service connection strings (Internal Docker network format)
ConnectionStrings__UserDb="Host=postgres;Port=5432;Database=usersdb;Username=postgres;Password=postgres_dev_password"
ConnectionStrings__MarketDb="Host=postgres;Port=5432;Database=marketdb;Username=postgres;Password=postgres_dev_password"
ConnectionStrings__PredictionDb="Host=postgres;Port=5432;Database=predictiondb;Username=postgres;Password=postgres_dev_password"
ConnectionStrings__PortfolioDb="Host=postgres;Port=5432;Database=portfoliodb;Username=postgres;Password=postgres_dev_password"
ConnectionStrings__SentimentDb="Host=postgres;Port=5432;Database=sentimentdb;Username=postgres;Password=postgres_dev_password"

# ------------------------------------------------------------------------------
# 3. Cache (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
Redis__ConnectionString="redis:6379,password=redis_dev_password,abortConnect=false"

# ------------------------------------------------------------------------------
# 4. Message Broker (RabbitMQ 3.12 Management)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RabbitMq__Host=rabbitmq
RabbitMq__Username=guest
RabbitMq__Password=guest

# ------------------------------------------------------------------------------
# 5. Security & Authentication (JWT / RSA)
# ------------------------------------------------------------------------------
JWT_ISSUER=finsightiq
JWT_AUDIENCE=finsightiq
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# RSA Keys for RS256 token signing (PEM format with escaped newlines or path)
# In local development, services can fallback to generated dev keys if empty.
JWT_PUBLIC_KEY_PEM=
JWT_PRIVATE_KEY_PEM=

# ------------------------------------------------------------------------------
# 6. External Market Data & NLP Provider APIs (Placeholders)
# ------------------------------------------------------------------------------
# Alpha Vantage (Market Data primary provider — 25 req/day on free tier)
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY

# Yahoo Finance (Market Data fallback provider)
YAHOO_FINANCE_API_KEY=YOUR_YAHOO_FINANCE_API_KEY

# NewsAPI (News headline provider for sentiment scoring — 100 req/day on developer tier)
NEWS_API_KEY=YOUR_NEWS_API_KEY

# SendGrid (Alert notifications by email)
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY

# ------------------------------------------------------------------------------
# 7. Internal Service Endpoints (Docker DNS)
# ------------------------------------------------------------------------------
API_GATEWAY_URL=http://gateway:5000
USER_SERVICE_URL=http://user-service:8080
MARKET_DATA_SERVICE_URL=http://market-data-service:8080
PREDICTION_SERVICE_URL=http://prediction-service:8080
PORTFOLIO_SERVICE_URL=http://portfolio-service:8080
SENTIMENT_SERVICE_URL=http://sentiment-service:8080
AI_ENGINE_URL=http://ai-engine:8000
NLP_ENGINE_URL=http://nlp-engine:8001

# ------------------------------------------------------------------------------
# 8. Host Port Mappings (Local Development)
# ------------------------------------------------------------------------------
PORT_GATEWAY=5000
PORT_WEB=5173
PORT_AI_ENGINE=8000
PORT_NLP_ENGINE=8001
PORT_POSTGRES=5432
PORT_REDIS=6379
PORT_RABBITMQ=5672
PORT_RABBITMQ_MGMT=15672
PORT_PROMETHEUS=9090
PORT_GRAFANA=3000

# ------------------------------------------------------------------------------
# 9. Monitoring & Observability
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_password
PROMETHEUS_RETENTION=15d
SERILOG_MINIMUM_LEVEL=Information
