# FinSightIQ Platform - .gitignore

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.cert
*.crt
id_rsa*

# Docker / Volume mounts
.docker/
docker-data/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Web / Playwright
node_modules/
dist/
build/
.playwright/
test-results/
playwright-report/
blob-report/

# .NET / C#
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/

# IDE / Editor configuration
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test reports and temporary artifacts
coverage/
tmp/
scratch/
